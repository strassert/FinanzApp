[Unit]
Description=Finanzen: verschlüsseltes Backup
RequiresMountsFor=/mnt/backup

[Service]
Type=oneshot
User=finanzen
Group=finanzen
Environment=FINANZEN_CONFIG=/etc/finanzen/config.toml
ExecStart=/opt/finanzen/venv/bin/python -m finanzen backup
WorkingDirectory=/opt/finanzen/app
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/finanzen /mnt/backup/finanzen
