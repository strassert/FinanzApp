[Unit]
Description=Finanzen: Konten abrufen
After=network-online.target finanzen.service

[Service]
Type=oneshot
User=finanzen
Group=finanzen
Environment=FINANZEN_CONFIG=/etc/finanzen/config.toml
ExecStart=/opt/finanzen/venv/bin/python -m finanzen sync
WorkingDirectory=/opt/finanzen/app
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/finanzen
